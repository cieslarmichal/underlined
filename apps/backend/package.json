{
  "name": "@apps/backend",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=./src --watch-path=./config src/index.ts",
    "build": "tsc --build tsconfig.prod.json",
    "build:dev": "tsc --build tsconfig.json",
    "test": "NODE_ENV=test vitest --config vitest.config.js",
    "test:ci": "npm run test -- --run",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1096.0",
    "@aws-sdk/lib-storage": "3.1096.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "bcrypt": "6.0.0",
    "config": "4.4.2",
    "fastify": "5.10.0",
    "jsonwebtoken": "9.0.3",
    "nanoid": "6.0.0",
    "pg": "8.22.0",
    "pg-boss": "12.26.3",
    "pino": "10.3.1",
    "resend": "6.18.0",
    "sharp": "0.35.3",
    "typebox": "1.3.8",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "10.5.0",
    "@types/bcrypt": "6.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pg": "8.20.0"
  }
}
